{
  "name": "skaffo",
  "version": "1.1.0",
  "description": "The fastest way to start any software project. Free and open source.",
  "author": "Skaffo",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5273 && electron .\"",
    "dev:web": "concurrently -k -n VITE,ENGINE -c cyan,green \"vite\" \"npm run engine\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "engine": "node scripts/run-engine.cjs",
    "setup": "node -e \"console.log('Run setup-engine.bat (Windows) or ./setup-engine.sh')\"",
    "build:engine": "python scripts/build-engine.py",
    "build:icon": "electron scripts/make-icon.cjs && python scripts/dekey.py",
    "dist": "npm run build && npm run build:engine && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "audit:app": "electron scripts/audit.cjs",
    "test:launcher": "node scripts/test-launcher.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.skaffo.app",
    "productName": "Skaffo",
    "copyright": "Copyright © 2026 ilia-dev-cmyk · MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/__pycache__/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Skaffo-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "engine/dist/skaffo-engine.exe",
          "to": "engine/skaffo-engine.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skaffo",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "ilia-dev-cmyk",
      "extraResources": [
        {
          "from": "engine/dist/skaffo-engine",
          "to": "engine/skaffo-engine"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "engine/dist/skaffo-engine",
          "to": "engine/skaffo-engine"
        }
      ]
    }
  }
}
